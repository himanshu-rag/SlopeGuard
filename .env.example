# SlopeGuard Environment Configuration
# Copy this file to .env and fill in your values

# ── Backend ──
DATABASE_URL=sqlite:///./slopeguard.db
# For Postgres: DATABASE_URL=postgresql+psycopg2://slopeguard:slopeguard@localhost:5432/slopeguard

# Optional API key for write endpoints (/simulate, /reports).
# If unset, auth is disabled (dev mode).
API_KEY=

# ── Frontend ──
# For local dev: http://localhost:8000
# For Android emulator: http://10.0.2.2:8000
# For real Android device: http://YOUR_COMPUTER_LAN_IP:8000
VITE_API_URL=http://localhost:8000

# ── OSRM (optional self-hosted) ──
OSRM_URL=http://router.project-osrm.org
# For self-hosted: OSRM_URL=http://localhost:5000

# ── Overpass API (optional self-hosted) ──
OVERPASS_URL=https://overpass-api.de/api/interpreter
